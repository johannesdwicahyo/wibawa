<%# The panel is positioned against the toolbar (the nearest `relative` parent), so it always fits the page. %>
<details data-wb-filters data-wb-popover>
  <summary class="<%= wibawa_button_class(:secondary) %> cursor-pointer list-none [&::-webkit-details-marker]:hidden">
    <%= icon("filter", size: "size-4") %><%= t("wibawa.filters") %>
    <% if chips.any? %><span class="font-normal tabular-nums text-ink-2"><%= chips.size %></span><% end %>
  </summary>

  <div class="absolute left-0 top-full z-30 mt-2 max-h-[70vh] w-80 overflow-y-auto rounded-card bg-surface p-4 shadow-lg ring-1 ring-line
              max-sm:fixed max-sm:inset-x-0 max-sm:bottom-0 max-sm:top-auto max-sm:mt-0 max-sm:w-auto max-sm:rounded-b-none">
    <div class="space-y-4">
      <% filters.each do |filter| %>
        <% type = type_for(filter) %>
        <div>
          <% if %i[date_range number_range].include?(type) %>
            <p class="mb-1.5 text-sm font-medium text-ink"><%= filter.label %></p>
            <div class="grid grid-cols-2 gap-2">
              <label>
                <span class="sr-only"><%= filter.label %> <%= t("wibawa.from") %></span>
                <input type="<%= range_input_type(filter) %>" form="<%= form_id %>" name="<%= field_name(filter, '_from') %>" value="<%= value(filter, '_from') %>"
                       placeholder="<%= t('wibawa.from') %>" step="any" class="<%= wibawa_input_class %> px-2.5">
              </label>
              <label>
                <span class="sr-only"><%= filter.label %> <%= t("wibawa.to") %></span>
                <input type="<%= range_input_type(filter) %>" form="<%= form_id %>" name="<%= field_name(filter, '_to') %>" value="<%= value(filter, '_to') %>"
                       placeholder="<%= t('wibawa.to') %>" step="any" class="<%= wibawa_input_class %> px-2.5">
              </label>
            </div>
          <% elsif type == :select %>
            <label for="<%= field_id(filter) %>" class="mb-1.5 block text-sm font-medium text-ink"><%= filter.label %></label>
            <%= helpers.select_tag field_name(filter), helpers.options_for_select(select_options(filter), value(filter)),
                  include_blank: t("wibawa.any"), id: field_id(filter), form: form_id, class: wibawa_input_class %>
          <% elsif type == :boolean %>
            <label for="<%= field_id(filter) %>" class="mb-1.5 block text-sm font-medium text-ink"><%= filter.label %></label>
            <%= helpers.select_tag field_name(filter), helpers.options_for_select(boolean_options, value(filter)),
                  include_blank: t("wibawa.any"), id: field_id(filter), form: form_id, class: wibawa_input_class %>
          <% else %>
            <label for="<%= field_id(filter) %>" class="mb-1.5 block text-sm font-medium text-ink"><%= filter.label %></label>
            <input type="search" id="<%= field_id(filter) %>" form="<%= form_id %>" name="<%= field_name(filter) %>" value="<%= value(filter) %>"
                   class="<%= wibawa_input_class %>">
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="mt-5 flex gap-2">
      <button type="submit" form="<%= form_id %>" class="<%= wibawa_button_class(:primary, 'flex-1') %>"><%= t("wibawa.apply_filters") %></button>
      <%= link_to t("wibawa.clear"), clear_url, class: wibawa_button_class(:secondary) %>
    </div>
  </div>
</details>

<% if chips.any? %>
  <ul class="order-last flex w-full flex-wrap gap-2" aria-label="<%= t('wibawa.active_filters') %>">
    <% chips.each do |chip| %>
      <li>
        <%= link_to chip[:url], "aria-label": t("wibawa.remove_filter", name: chip[:label]),
              class: "inline-flex items-center gap-1.5 rounded-control bg-surface py-1 pl-2.5 pr-1.5 text-xs text-ink ring-1 ring-line transition-colors hover:bg-surface-2" do %>
          <span class="text-ink-2"><%= chip[:label] %></span><%= chip[:value] %><%= icon("x", size: "size-3.5", class: "text-ink-3") %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
