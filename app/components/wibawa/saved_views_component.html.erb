<details data-wb-popover data-wb-saved-views>
  <summary class="<%= wibawa_button_class(:secondary) %> cursor-pointer list-none [&::-webkit-details-marker]:hidden">
    <%= icon("eye", size: "size-4") %><%= current&.name || t("wibawa.views") %>
  </summary>

  <div class="absolute left-0 top-full z-30 mt-2 max-h-[70vh] w-80 overflow-y-auto rounded-card bg-surface p-2 shadow-lg ring-1 ring-line
              max-sm:fixed max-sm:inset-x-0 max-sm:bottom-0 max-sm:top-auto max-sm:mt-0 max-sm:w-auto max-sm:rounded-b-none">
    <% if views.empty? %>
      <p class="px-2 py-3 text-sm text-ink-2"><%= t("wibawa.no_views") %></p>
    <% else %>
      <ul>
        <% views.each do |view| %>
          <li class="relative">
            <%= link_to url_for_view(view), "aria-current": (view == current ? "true" : nil),
                  class: class_names("flex min-w-0 items-center gap-2 rounded-control px-2 py-2 text-sm text-ink hover:bg-surface-2", "font-semibold" => view == current, "pr-10" => own?(view)) do %>
              <span class="truncate"><%= view.name %></span>
              <% if view.default_view && own?(view) %><span class="<%= badge_class %>"><%= t("wibawa.default_view") %></span><% end %>
              <% if view.shared %><span class="<%= badge_class %>"><%= t("wibawa.shared_view") %></span><% end %>
            <% end %>
            <% if own?(view) %>
              <details data-wb-view-edit>
                <summary class="<%= wibawa_button_class(:ghost, "absolute right-1 top-1 cursor-pointer list-none p-1.5 [&::-webkit-details-marker]:hidden") %>" aria-label="<%= t("wibawa.edit_view", name: view.name) %>">
                  <%= icon("pencil", size: "size-4") %>
                </summary>
                <div class="mb-2 space-y-3 rounded-control bg-surface-2 p-3">
                  <%= helpers.form_with url: update_url(view), method: :patch, class: "space-y-3" do |f| %>
                    <label class="block">
                      <span class="mb-1.5 block text-sm font-medium text-ink"><%= t("wibawa.view_name") %></span>
                      <%= f.text_field :name, value: view.name, required: true, maxlength: 60, autocomplete: "off", id: "wb-view-name-#{view.id}", class: wibawa_input_class %>
                    </label>
                    <% if sharing? %>
                      <label class="flex items-center gap-2 text-sm text-ink">
                        <%= f.check_box :shared, { checked: view.shared, id: "wb-view-shared-#{view.id}", class: check_class }, "1", "0" %><%= t("wibawa.share_view") %>
                      </label>
                    <% end %>
                    <label class="flex items-center gap-2 text-sm text-ink">
                      <%= f.check_box :default_view, { checked: view.default_view, id: "wb-view-default-#{view.id}", class: check_class }, "1", "0" %><%= t("wibawa.open_by_default") %>
                    </label>
                    <%= f.button t("wibawa.save"), type: "submit", class: wibawa_button_class(:primary), data: { turbo_submits_with: t("wibawa.form.saving") } %>
                  <% end %>
                  <%= button_to destroy_url(view), method: :delete, class: wibawa_button_class(:ghost, "hover:!text-danger"),
                        form: { data: { turbo_confirm: t("wibawa.confirm_delete", name: view.name) } } do %>
                    <%= icon("trash", size: "size-4") %><%= t("wibawa.delete_view", name: view.name) %>
                  <% end %>
                </div>
              </details>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <%= helpers.form_with url: create_url, method: :post, class: "mt-2 flex items-end gap-2 border-t border-line px-2 pb-2 pt-3" do |f| %>
      <%= f.hidden_field :query, value: current_query %>
      <label class="min-w-0 flex-1">
        <span class="mb-1.5 block text-sm font-medium text-ink"><%= t("wibawa.save_view") %></span>
        <%= f.text_field :name, required: true, maxlength: 60, placeholder: t("wibawa.view_name"), autocomplete: "off", class: wibawa_input_class %>
      </label>
      <%= f.button t("wibawa.save"), type: "submit", class: wibawa_button_class(:primary), data: { turbo_submits_with: t("wibawa.form.saving") } %>
    <% end %>
  </div>
</details>
