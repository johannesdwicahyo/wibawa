<details data-wb-popover data-wb-saved-views>
  <summary class="<%= wibawa_button_class(:secondary) %> cursor-pointer list-none [&::-webkit-details-marker]:hidden">
    <%= icon("eye", size: "size-4") %><%= current&.name || t("wibawa.views") %>
  </summary>

  <div class="absolute left-0 top-full z-30 mt-2 max-h-[70vh] w-80 overflow-y-auto rounded-card bg-surface p-2 shadow-lg ring-1 ring-line
              max-sm:fixed max-sm:inset-x-0 max-sm:bottom-0 max-sm:top-auto max-sm:mt-0 max-sm:w-auto max-sm:rounded-b-none">
    <% if views.empty? %>
      <p class="px-2 py-3 text-sm text-ink-2"><%= t("wibawa.no_views") %></p>
    <% else %>
      <ul>
        <% views.each do |view| %>
          <li class="flex items-center gap-1 rounded-control hover:bg-surface-2">
            <%= link_to view.name, url_for_view(view), "aria-current": (view == current ? "true" : nil),
                  class: class_names("min-w-0 flex-1 truncate px-2 py-2 text-sm text-ink", "font-semibold" => view == current) %>
            <%= button_to destroy_url(view), method: :delete, class: wibawa_button_class(:ghost, "p-1.5 hover:!text-danger"),
                  "aria-label": t("wibawa.delete_view", name: view.name),
                  form: { class: "contents", data: { turbo_confirm: t("wibawa.confirm_delete", name: view.name) } } do %>
              <%= icon("x", size: "size-4") %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <%= helpers.form_with url: create_url, method: :post, class: "mt-2 flex items-end gap-2 border-t border-line px-2 pb-2 pt-3" do |f| %>
      <%= f.hidden_field :query, value: current_query %>
      <label class="min-w-0 flex-1">
        <span class="mb-1.5 block text-sm font-medium text-ink"><%= t("wibawa.save_view") %></span>
        <%= f.text_field :name, required: true, maxlength: 60, placeholder: t("wibawa.view_name"), autocomplete: "off", class: wibawa_input_class %>
      </label>
      <%= f.button t("wibawa.save"), type: "submit", class: wibawa_button_class(:primary), data: { turbo_submits_with: t("wibawa.form.saving") } %>
    <% end %>
  </div>
</details>
