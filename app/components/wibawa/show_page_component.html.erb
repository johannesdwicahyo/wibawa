<%= render wibawa_component(:page_header, Wibawa::PageHeaderComponent).new(title: title, breadcrumbs: breadcrumbs, actions: header_actions) %>

<div class="space-y-6">
  <% sections.each do |items| %>
    <% kind = items.first.first %>
    <% if kind == :row %>
      <section class="<%= card_class %>">
        <dl class="divide-y divide-line">
          <% items.each do |(_, column)| %>
            <div class="grid gap-1 px-5 py-3 sm:grid-cols-[13rem_1fr] sm:gap-6">
              <dt class="text-sm text-ink-2"><%= column.options[:label] || record.class.human_attribute_name(column.name) %></dt>
              <dd class="min-w-0 break-words text-sm text-ink"><%= value(column) %></dd>
            </div>
          <% end %>
        </dl>
      </section>
    <% else %>
      <% items.each do |item| %>
        <% if item.first == :panel %>
          <section class="<%= card_class %>">
            <h2 class="border-b border-line px-5 py-3 text-sm font-semibold"><%= item[1] %></h2>
            <div class="px-5 py-4 text-sm"><%= panel_content(item[2]) %></div>
          </section>
        <% elsif item.first == :table %>
          <% _, name, options, builder = item %>
          <% rows = association_records(name, options[:limit]) %>
          <% cols = association_columns(name, builder) %>
          <section class="<%= card_class %> overflow-hidden">
            <h2 class="flex items-center gap-2 border-b border-line px-5 py-3 text-sm font-semibold">
              <%= association_title(name, options) %>
              <span class="text-xs font-normal tabular-nums text-ink-2"><%= rows.size %><%= "+" if rows.size >= options[:limit] %></span>
            </h2>
            <% if rows.empty? %>
              <p class="px-5 py-6 text-sm text-ink-2"><%= t("wibawa.none") %></p>
            <% else %>
              <div class="relative overflow-x-auto">
                <table class="min-w-full text-sm">
                  <thead>
                    <tr class="border-b border-line text-left">
                      <% cols.each do |c| %><th scope="col" class="whitespace-nowrap px-5 py-2 font-medium text-ink-2"><%= c.label %></th><% end %>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-line">
                    <% rows.each do |row| %>
                      <tr>
                        <% cols.each do |c| %><td class="px-5 py-2.5 text-ink"><%= presenter.cell(row, c) %></td><% end %>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% end %>
          </section>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if history %>
    <section class="<%= card_class %>" data-wb-history>
      <h2 class="flex items-center gap-2 border-b border-line px-5 py-3 text-sm font-semibold">
        <%= t("wibawa.history.title") %>
        <span class="text-xs font-normal tabular-nums text-ink-2"><%= history.size %><%= "+" if history.size >= Wibawa::ModelHistory::LIMIT %></span>
      </h2>
      <% if history.empty? %>
        <p class="px-5 py-6 text-sm text-ink-2"><%= t("wibawa.none") %></p>
      <% else %>
        <ol class="divide-y divide-line">
          <% history.each do |entry| %>
            <li class="grid gap-1 px-5 py-3 text-sm sm:grid-cols-[13rem_1fr] sm:gap-6">
              <div class="text-ink-2">
                <%= presenter.format(entry.at, :datetime) %>
                <% if entry.who %><span class="block truncate"><%= entry.who %></span><% end %>
              </div>
              <div class="min-w-0 text-ink">
                <p class="font-medium"><%= history_event(entry) %></p>
                <% if entry.changes.any? %>
                  <dl class="mt-1 space-y-0.5">
                    <% entry.changes.each do |name, change| %>
                      <div class="break-words">
                        <dt class="inline text-ink-2"><%= record.class.human_attribute_name(name) %>:</dt>
                        <dd class="inline"><%= helpers.wibawa_change(change) %></dd>
                      </div>
                    <% end %>
                  </dl>
                <% end %>
              </div>
            </li>
          <% end %>
        </ol>
      <% end %>
    </section>
  <% end %>
</div>
