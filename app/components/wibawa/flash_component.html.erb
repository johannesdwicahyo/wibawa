<% messages.each do |type, message| %>
  <div data-wb-flash role="status" class="mb-5 flex items-start gap-3 rounded-control px-4 py-3 text-sm ring-1 ring-inset <%= tone_class(type) %>">
    <p class="flex-1"><%= message %></p>
    <button type="button" data-wb-dismiss class="-m-1 rounded p-1 opacity-60 hover:opacity-100" aria-label="<%= t('wibawa.dismiss') %>">
      <%= icon("x", size: "size-4") %>
    </button>
  </div>
<% end %>
