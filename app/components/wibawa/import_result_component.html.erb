<% if failed? %>
  <div role="alert" class="rounded-control bg-danger/10 px-4 py-3 text-sm text-danger ring-1 ring-inset ring-danger/30">
    <p class="font-medium"><%= t("wibawa.import.failed") %></p>
    <ul class="mt-2 space-y-1">
      <% errors.each do |line, message| %>
        <li><% if line %><span class="font-medium tabular-nums"><%= t("wibawa.import.line", line: line) %></span> <% end %><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% if checked? %>
  <section class="rounded-card bg-surface ring-1 ring-line" data-wb-import-preview>
    <div role="status" class="px-5 py-4 text-sm">
      <p class="font-medium text-ink"><%= t("wibawa.import.checked", created: result.created, updated: result.updated) %></p>
      <p class="mt-1 text-ink-2"><%= t("wibawa.import.not_yet") %></p>
    </div>
    <% if preview.any? %>
      <div class="border-t border-line">
        <%= render wibawa_component(:table, Wibawa::TableComponent).new(headings: preview_headings, rows: preview, align: :top,
                                                                     caption: t("wibawa.import.preview", count: preview.size),
                                                                     cells: ->(row) { preview_cells(*row) }) %>
      </div>
    <% end %>
  </section>
<% end %>
