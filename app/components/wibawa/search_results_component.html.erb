<% hits.each do |resource, record, path| %>
  <li role="presentation">
    <%= link_to path, role: "option", "aria-selected": "false", tabindex: -1, class: "flex items-center gap-3 rounded-control px-3 py-2 text-sm text-ink aria-selected:bg-surface-2" do %>
      <%= icon(resource.menu_icon, size: "size-4", class: "shrink-0 text-ink-3") %>
      <span class="min-w-0 flex-1 truncate"><%= label(record) %></span>
      <span class="shrink-0 text-xs text-ink-2"><%= hint(resource) %></span>
    <% end %>
  </li>
<% end %>
