<div data-wb-sidebar-backdrop class="fixed inset-0 z-30 hidden bg-zinc-950/50 lg:hidden"></div>

<aside data-wb-sidebar
       class="wb-sidebar fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col bg-rail text-white transition-transform duration-200 lg:translate-x-0">
  <div class="flex h-16 shrink-0 items-center gap-3 px-5">
    <%= link_to root_path, class: "flex min-w-0 items-center gap-3 rounded-control focus-visible:outline-2 focus-visible:outline-white/60" do %>
      <span class="grid size-8 shrink-0 place-items-center rounded-control bg-white text-sm font-bold text-rail"><%= default_title? ? helpers.wibawa_mark : initials %></span>
      <span class="truncate text-[15px] font-semibold tracking-tight"><%= title %></span>
    <% end %>
    <button type="button" data-wb-sidebar-close class="ml-auto rounded-md p-1 text-white/70 hover:text-white lg:hidden" aria-label="<%= t('wibawa.close_menu') %>">
      <%= icon("x") %>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto px-3 pb-6" aria-label="<%= t('wibawa.navigation') %>">
    <%= link_to root_path, class: link_class(dashboard_active?), "aria-current": (dashboard_active? ? "page" : nil) do %>
      <%= icon("home", class: "opacity-80") %><span><%= t("wibawa.dashboard") %></span>
    <% end %>

    <% groups.each do |name, resources| %>
      <% if name %>
        <p class="mb-1 mt-6 px-2.5 text-xs font-medium text-white/70"><%= name %></p>
      <% else %>
        <div class="mt-1"></div>
      <% end %>
      <ul class="space-y-0.5">
        <% resources.each do |resource| %>
          <li>
            <%= link_to resources_path(resource: resource.key), class: link_class(active?(resource)), "aria-current": (active?(resource) ? "page" : nil) do %>
              <%= icon(resource.menu_icon, class: "opacity-80") %>
              <span class="truncate"><%= resource.label %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% report_groups.each do |name, reports| %>
      <p class="mb-1 mt-6 px-2.5 text-xs font-medium text-white/70"><%= name %></p>
      <ul class="space-y-0.5">
        <% reports.each do |report| %>
          <li>
            <%= link_to helpers.report_path(report: report.key), class: link_class(report_active?(report)), "aria-current": (report_active?(report) ? "page" : nil) do %>
              <%= icon(report.menu_icon, class: "opacity-80") %>
              <span class="truncate"><%= report.title %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </nav>

  <div class="wb-kawung shrink-0 border-t border-white/10 px-3 py-3">
    <div class="flex items-center gap-2">
      <% if user_label %>
        <p class="min-w-0 flex-1 truncate px-2.5 text-sm text-white/80" title="<%= user_label %>"><%= user_label %></p>
      <% else %>
        <div class="flex-1"></div>
      <% end %>
      <button type="button" data-wb-theme-toggle class="rounded-md p-1.5 text-white/70 hover:bg-white/10 hover:text-white" aria-label="<%= t('wibawa.toggle_theme') %>">
        <span class="dark:hidden"><%= icon("moon", size: "size-[18px]") %></span>
        <span class="hidden dark:inline"><%= icon("sun", size: "size-[18px]") %></span>
      </button>
      <% if logout_path %>
        <%= button_to logout_path, method: Wibawa.config.logout_method, class: "rounded-md p-1.5 text-white/70 hover:bg-white/10 hover:text-white",
                      title: t("wibawa.sign_out"), "aria-label": t("wibawa.sign_out"), form: { class: "contents" } do %>
          <%= icon("logout", size: "size-[18px]") %>
        <% end %>
      <% end %>
    </div>
  </div>
</aside>
