<%= render wibawa_component(:page_header, Wibawa::PageHeaderComponent).new(title: report.title, subtitle: report.description, actions: header_actions) %>

<% if report.params.any? %>
  <form action="<%= helpers.report_path(report: report.key) %>" method="get" data-turbo-action="advance" class="mb-4 flex flex-wrap items-end gap-3">
    <% report.params.each do |param| %>
      <div>
        <label for="<%= param_id(param) %>" class="mb-1.5 block text-sm font-medium text-ink"><%= param.label %></label>
        <% if param.as == :select %>
          <%= helpers.select_tag param_name(param), helpers.options_for_select(options_for(param), values[param.name]),
                include_blank: t("wibawa.any"), id: param_id(param), class: "#{wibawa_input_class} min-w-40" %>
        <% else %>
          <input type="<%= { date: 'date', number: 'number' }.fetch(param.as, 'text') %>" id="<%= param_id(param) %>" name="<%= param_name(param) %>"
                 value="<%= values[param.name] %>" step="any" class="<%= wibawa_input_class %> w-44">
        <% end %>
      </div>
    <% end %>
    <button type="submit" class="<%= wibawa_button_class(:primary) %>"><%= t("wibawa.run_report") %></button>
  </form>
<% end %>

<% if rows.empty? %>
  <div class="<%= card_class %> flex flex-col items-center px-6 py-16 text-center">
    <%= icon("inbox", size: "size-6", class: "text-ink-3") %>
    <p class="mt-4 text-sm font-medium text-ink"><%= t("wibawa.report_empty") %></p>
  </div>
<% else %>
  <% if bars.any? %>
    <%# One series, so no legend: the column header names it. Values stay in ink; the table below is the full view. %>
    <div class="<%= card_class %> mb-4 p-5" role="img" aria-label="<%= chart_column.label %>">
      <p class="mb-4 text-sm font-medium text-ink-2"><%= chart_column.label %></p>
      <div class="grid grid-cols-[minmax(4rem,max-content)_1fr_max-content] items-center gap-x-3 gap-y-2 text-sm">
        <% bars.each do |label, raw, percent| %>
          <span class="max-w-48 truncate text-ink-2"><%= label %></span>
          <span class="h-2.5" title="<%= label %>: <%= helpers.strip_tags(chart_value(raw).to_s) %>">
            <span class="block h-full min-w-px rounded-r bg-primary" style="width: <%= percent %>%"></span>
          </span>
          <span class="text-right tabular-nums text-ink"><%= chart_value(raw) %></span>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if line_points.size > 1 %>
    <%# One series, so no legend. The SVG stretches with the card; labels and the hover layer are HTML so they never distort. %>
    <div class="<%= card_class %> mb-4 p-5" role="img" aria-label="<%= chart_column.label %>">
      <p class="mb-4 text-sm font-medium text-ink-2"><%= chart_column.label %></p>
      <div class="flex gap-3">
        <div class="flex h-56 flex-col justify-between text-right text-xs tabular-nums text-ink-2">
          <% y_ticks.each do |tick| %><span><%= chart_value(tick) %></span><% end %>
        </div>
        <div class="min-w-0 flex-1">
          <div class="relative h-56">
            <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="absolute inset-0 size-full overflow-visible" aria-hidden="true">
              <% [0, 50, 100].each do |y| %>
                <line x1="0" x2="100" y1="<%= y %>" y2="<%= y %>" class="stroke-line" stroke-width="1" vector-effect="non-scaling-stroke" />
              <% end %>
              <polyline points="<%= polyline %>" class="fill-none stroke-primary" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
            </svg>
            <div class="absolute inset-0 flex">
              <% line_points.each_with_index do |point, index| %>
                <div class="group/point relative flex-1">
                  <span class="absolute inset-y-0 left-1/2 hidden w-px bg-ink-3 group-hover/point:block"></span>
                  <span class="absolute left-1/2 hidden size-2.5 -translate-x-1/2 translate-y-1/2 rounded-full bg-primary ring-2 ring-surface group-hover/point:block" style="bottom: <%= point.y %>%"></span>
                  <span class="<%= class_names('pointer-events-none absolute -top-2 z-10 hidden -translate-y-full whitespace-nowrap rounded-control bg-ink px-2 py-1 text-xs text-surface group-hover/point:block',
                                               index < line_points.size / 2 ? 'left-1/2' : 'right-1/2') %>"><%= point.label %>: <span class="tabular-nums"><%= helpers.strip_tags(chart_value(point.raw).to_s) %></span></span>
                </div>
              <% end %>
            </div>
          </div>
          <div class="mt-2 flex justify-between text-xs text-ink-2">
            <% x_labels.each do |label| %><span><%= label %></span><% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="<%= card_class %> overflow-hidden">
    <div class="relative overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="border-b border-line bg-surface-2 text-left">
            <% columns.each do |column| %>
              <th scope="col" class="<%= class_names('whitespace-nowrap px-4 py-2.5 font-medium text-ink-2', 'text-right' => numeric?(column)) %>"><%= column.label %></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% shown_rows.each do |row| %>
            <tr class="transition-colors hover:bg-surface-2">
              <% columns.each do |column| %>
                <td class="<%= class_names('px-4 py-2 align-middle text-ink', 'text-right tabular-nums' => numeric?(column)) %>"><%= cell(row, column) %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <% if truncated? %>
    <p class="mt-3 text-sm text-ink-2"><%= t("wibawa.report_truncated", count: Wibawa::Report::MAX_ROWS) %></p>
  <% end %>
<% end %>
