<header class="mb-6">
  <% if breadcrumbs.any? %>
    <nav aria-label="<%= t('wibawa.breadcrumbs') %>" class="mb-2">
      <ol class="flex flex-wrap items-center gap-1 text-sm text-ink-2">
        <% breadcrumbs.each_with_index do |(label, url), i| %>
          <% if i.positive? %><li aria-hidden="true"><%= icon("chevron-right", size: "size-3.5") %></li><% end %>
          <li><%= url ? link_to(label, url, class: "hover:text-ink") : label %></li>
        <% end %>
      </ol>
    </nav>
  <% end %>
  <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
    <div class="min-w-0">
      <h1 class="text-2xl font-semibold tracking-tight text-ink"><%= title %></h1>
      <% if subtitle %><p class="mt-1 text-sm text-ink-2"><%= subtitle %></p><% end %>
    </div>
    <% if actions.any? %>
      <div class="<%= class_names('flex flex-wrap items-center gap-2', 'max-sm:hidden' => overflow.any?) %>">
        <% actions.each do |action| %><%= action_button(action) %><% end %>
      </div>
    <% end %>
    <% if overflow.any? %>
      <div class="relative flex w-full items-center gap-2 sm:hidden">
        <% if primary %><%= action_button(primary) %><% end %>
        <details data-wb-popover data-wb-more>
          <summary class="<%= wibawa_button_class(:secondary, 'list-none px-2.5 [&::-webkit-details-marker]:hidden') %>" aria-label="<%= t('wibawa.more_actions') %>">
            <%= icon("more") %>
          </summary>
          <div class="absolute inset-x-0 top-full z-30 mt-2 rounded-card bg-surface p-1 shadow-lg ring-1 ring-line">
            <% overflow.each do |action| %><%= action_button(action, menu: true) %><% end %>
          </div>
        </details>
      </div>
    <% end %>
  </div>
</header>
