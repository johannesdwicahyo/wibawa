<div class="<%= card_class %> overflow-hidden" data-wb-table>
  <% if selectable? %>
    <%= helpers.form_tag batch_resources_path(resource: resource.key), id: batch_form_id, method: :post, class: "hidden" do %><% end %>

    <div data-wb-batch-bar hidden
         class="flex flex-wrap items-center gap-2 border-b border-line bg-primary/[0.06] px-4 py-2.5 dark:bg-primary/15">
      <p class="mr-2 text-sm font-medium text-ink" aria-live="polite">
        <span data-wb-selected-count>0</span> <%= t("wibawa.selected") %>
      </p>
      <% batch_actions.each do |action| %>
        <button type="submit" form="<%= batch_form_id %>" name="batch_action" value="<%= action.name %>"
                <% if (confirm = batch_confirm(action)) %>data-turbo-confirm="<%= confirm %>"<% end %>
                class="<%= wibawa_button_class(action.destructive? ? :danger : :secondary, 'py-1.5') %>">
          <%= action.label %>
        </button>
      <% end %>
    </div>
  <% end %>

  <% if records.empty? %>
    <div class="flex flex-col items-center px-6 py-16 text-center">
      <%= icon("inbox", size: "size-6", class: "text-ink-3") %>
      <p class="mt-4 text-sm font-medium text-ink"><%= empty_message %></p>
      <% if !query.filtered? && can_create? %>
        <%= link_to new_resource_path(resource: resource.key), class: wibawa_button_class(:primary, "mt-5") do %>
          <%= icon("plus", size: "size-4") %><%= t("wibawa.new_record", resource: resource.singular_label) %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <%# The card is the scroller in both directions, capped to the window, so the header can stick. %>
    <div class="relative max-h-[calc(100dvh-8rem)] scroll-pt-12 overflow-auto">
      <% if row_actions? %>
        <%= helpers.wibawa_icon_sprite(*row_icons) if row_icons.any? %>
        <% if row_delete? %>
          <form id="<%= row_form_id %>" method="post" hidden><input type="hidden" name="authenticity_token" value="<%= helpers.form_authenticity_token %>" autocomplete="off"></form>
        <% end %>
      <% end %>
      <table class="min-w-full text-sm">
        <thead class="sticky top-0 z-10">
          <tr class="bg-surface-2 text-left">
            <% if selectable? %>
              <th scope="col" class="<%= th_class('w-10 py-2.5 pl-4 pr-1') %>">
                <input type="checkbox" data-wb-select-all aria-label="<%= t('wibawa.select_all') %>"
                       class="size-4 rounded border-line text-primary accent-[var(--color-primary)]">
              </th>
            <% end %>
            <% columns.each do |column| %>
              <th scope="col" aria-sort="<%= aria_sort(column) %>"
                  class="<%= th_class('whitespace-nowrap px-4 py-2.5 font-medium text-ink-2', pinned(column, :header), 'text-right' => numeric?(column)) %>">
                <% if sortable?(column) %>
                  <%= link_to sort_url(column), class: class_names("group inline-flex items-center gap-1 hover:text-ink", "flex-row-reverse" => numeric?(column), "text-ink" => sorted?(column)) do %>
                    <%= column.label %>
                    <%= icon(sort_icon(column), size: "size-3.5", class: class_names("text-ink-3", "opacity-0 group-hover:opacity-100" => !sorted?(column))) %>
                  <% end %>
                <% else %>
                  <%= column.label %>
                <% end %>
              </th>
            <% end %>
            <% if row_actions? %><th scope="col" class="<%= th_class('px-4 py-2.5') %>"><span class="sr-only"><%= t("wibawa.actions") %></span></th><% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% records.each do |record| %>
            <tr class="group/row wb-row">
              <% if selectable? %>
                <td class="w-10 <%= row_pad %> pl-4 pr-1">
                  <input type="checkbox" name="ids[]" value="<%= record.id %>" form="<%= batch_form_id %>" data-wb-select
                         aria-label="<%= t('wibawa.select_record', name: presenter.display_name(record)) %>"
                         class="wb-check">
                </td>
              <% end %>
              <% columns.each do |column| %>
                <td class="<%= class_names('px-4 align-middle text-ink', row_pad, pinned(column, :cell), 'text-right' => numeric?(column), 'max-w-xs' => !numeric?(column)) %>"><%= cell(record, column) %></td>
              <% end %>
              <% if row_actions? %>
                <td class="whitespace-nowrap px-3 py-0 text-right">
                  <div class="wb-row-actions">
                    <%= custom_row_actions(record) %>
                    <% if show_row_action?(:show) && wibawa_authorized?(:show, record) %>
                      <a class="wb-row-action" title="<%= t("wibawa.view") %>" href="<%= resource_path(resource: resource.key, id: record) %>"><%= helpers.wibawa_icon_use("eye") %><span class="sr-only"><%= t("wibawa.view") %></span></a>
                    <% end %>
                    <% if show_row_action?(:edit) && wibawa_authorized?(:edit, record) %>
                      <a class="wb-row-action" title="<%= t("wibawa.edit") %>" href="<%= edit_resource_path(resource: resource.key, id: record) %>"><%= helpers.wibawa_icon_use("pencil") %><span class="sr-only"><%= t("wibawa.edit") %></span></a>
                    <% end %>
                    <% if row_delete? && wibawa_authorized?(:destroy, record) %>
                      <button type="submit" form="<%= row_form_id %>" formaction="<%= resource_path(resource: resource.key, id: record) %>" name="_method" value="delete"
                              class="wb-row-action wb-row-action-danger" title="<%= t("wibawa.delete") %>" data-turbo-confirm="<%= t("wibawa.confirm_delete", name: presenter.display_name(record)) %>"><%= helpers.wibawa_icon_use("trash") %><span class="sr-only"><%= t("wibawa.delete") %></span></button>
                    <% end %>
                  </div>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
