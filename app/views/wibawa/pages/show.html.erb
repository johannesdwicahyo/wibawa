<% content_for :title, page.title %>
<%# The app's content is rendered here, in the view, so its template or block sees what it always did. %>
<%= render wibawa_component(:custom_page, Wibawa::CustomPageComponent).new(page: page) do %>
  <% if page.view %>
    <%= render template: page.view %>
  <% elsif page.content_block %>
    <%= instance_exec(&page.content_block) %>
  <% end %>
<% end %>
