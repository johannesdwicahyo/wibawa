<% title = t("wibawa.import.title", resource: resource.label) %>
<% content_for :title, title %>
<%= render wibawa_component(:page_header, Wibawa::PageHeaderComponent).new(
      title: title, subtitle: @import.filename,
      breadcrumbs: [[resource.label, resources_path(resource: resource.key)], [t("wibawa.import.button"), import_resource_path(resource: resource.key)], [@import.filename.presence || "##{@import.id}", nil]]) %>

<div class="max-w-3xl space-y-6" data-wb-import-status="<%= @import.status %>">
  <% if @import.waiting? %>
    <%# wibawa.js loads this page again every few seconds while data-wb-reload is on it; the link does the same by hand. %>
    <div role="status" data-wb-reload class="rounded-card bg-surface px-5 py-4 text-sm ring-1 ring-line">
      <p class="font-medium text-ink"><%= t("wibawa.import.status.#{@import.status}") %></p>
      <p class="mt-1 text-ink-2"><%= t("wibawa.import.waiting") %></p>
      <p class="mt-3"><%= link_to t("wibawa.import.check_again"), import_status_resource_path(resource: resource.key, id: @import), class: wibawa_button_class(:secondary) %></p>
    </div>
  <% else %>
    <% outcome = @import.outcome %>
    <% if outcome.ok? && !@import.dry_run %>
      <div role="status" class="rounded-control bg-success/10 px-4 py-3 text-sm text-success ring-1 ring-inset ring-success/30">
        <%= t("wibawa.flash.imported", created: outcome.created, updated: outcome.updated) %>
      </div>
    <% else %>
      <%= render "import_result", result: outcome %>
    <% end %>
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to t("wibawa.import.again"), import_resource_path(resource: resource.key), class: wibawa_button_class(:secondary) %>
      <%= link_to resource.label, resources_path(resource: resource.key), class: wibawa_button_class(:ghost) %>
    </div>
  <% end %>
</div>
