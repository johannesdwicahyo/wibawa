<% @hits.each do |resource, record, path| %>
  <li role="option" aria-selected="false" class="rounded-control aria-selected:bg-surface-2">
    <%= link_to path, class: "flex items-center gap-3 px-3 py-2 text-sm text-ink" do %>
      <%= wibawa_icon(resource.menu_icon, size: "size-4", class: "shrink-0 text-ink-3") %>
      <span class="min-w-0 flex-1 truncate"><%= wibawa_presenter.display_name(record) %></span>
      <span class="shrink-0 text-xs text-ink-2"><%= resource.singular_label %></span>
    <% end %>
  </li>
<% end %>
