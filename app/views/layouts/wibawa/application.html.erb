<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
    <meta name="view-transition" content="same-origin">
    <title><%= [content_for(:title), Wibawa.config.site_title].compact_blank.join(" – ") %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= javascript_tag nonce: true do %>
      try {
        var t = localStorage.getItem("wibawa-theme");
        if (t === "dark" || (!t && matchMedia("(prefers-color-scheme: dark)").matches)) document.documentElement.classList.add("dark");
      } catch (e) {}
    <% end %>

    <%= wibawa_font_face if Wibawa.config.font == :bundled %>
    <%= stylesheet_link_tag "wibawa", "data-turbo-track": "reload" %>
    <% if Wibawa.config.brand_color.present? %>
      <%= tag.style(":root { --wb-primary: #{Wibawa.config.brand_color.to_s.gsub(/[;{}<>]/, '')}; }".html_safe, nonce: content_security_policy_nonce) %>
    <% end %>
    <%= javascript_include_tag "turbo.min", type: "module", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "wibawa", type: "module", "data-turbo-track": "reload" %>
    <%= yield :head %>
  </head>

  <body class="h-full bg-canvas font-sans text-ink antialiased">
    <%= render wibawa_component(:sidebar, Wibawa::SidebarComponent).new(current_key: params[:resource]) %>

    <div class="lg:pl-64">
      <div class="sticky top-0 z-20 flex h-14 items-center gap-3 border-b border-line bg-canvas/90 px-4 backdrop-blur lg:hidden">
        <button type="button" data-wb-sidebar-open class="<%= wibawa_button_class(:ghost, '-ml-2 px-2') %>" aria-label="<%= t('wibawa.open_menu') %>">
          <%= wibawa_icon("menu") %>
        </button>
        <%= link_to Wibawa.config.site_title, root_path, class: "truncate text-[15px] font-semibold" %>
      </div>

      <main class="mx-auto max-w-[1600px] px-4 pb-16 pt-6 sm:px-6 lg:px-10 lg:pt-8">
        <% flash.each do |type, message| %>
          <% next if message.blank? || !message.is_a?(String) %>
          <div data-wb-flash role="status"
               class="mb-5 flex items-start gap-3 rounded-control px-4 py-3 text-sm ring-1 ring-inset <%= type.to_s.in?(%w[alert error]) ? 'bg-rose-50 text-rose-800 ring-rose-200 dark:bg-rose-500/10 dark:text-rose-200 dark:ring-rose-500/30' : 'bg-emerald-50 text-emerald-800 ring-emerald-200 dark:bg-emerald-500/10 dark:text-emerald-200 dark:ring-emerald-500/30' %>">
            <p class="flex-1"><%= message %></p>
            <button type="button" data-wb-dismiss class="-m-1 rounded p-1 opacity-60 hover:opacity-100" aria-label="<%= t('wibawa.dismiss') %>">
              <%= wibawa_icon("x", size: "size-4") %>
            </button>
          </div>
        <% end %>

        <%= yield %>
      </main>
    </div>
  </body>
</html>
